###### Analysis View, Corners and Modes ######

eda:AnalysisView a owl:Class ;
    rdfs:label "Analysis View" ;
    rdfs:comment "A context for analysis defined by specific corners and modes." .

eda:Corner a owl:Class ;
    rdfs:label "Corner" ;
    rdfs:comment "A specific set of process, voltage, and temperature conditions for analysis." .

eda:Mode a owl:Class ;
    rdfs:label "Mode" ;
    rdfs:comment "A functional or test mode of operation for the design." .

eda:RCCorner a owl:Class ;
    rdfs:subClassOf eda:Corner ;
    rdfs:label "RC Corner" ;
    rdfs:comment "Resistance-Capacitance corner, defines parasitic values." .

eda:LibCorner a owl:Class ;
    rdfs:subClassOf eda:Corner ;
    rdfs:label "Lib Corner" ;
    rdfs:comment "Library corner, defines cell timing/power characterization." .

eda:ProcessCorner a owl:Class ;
    rdfs:subClassOf eda:Corner ;
    rdfs:label "Process Corner" ;
    rdfs:comment "Manufacturing process variation corner (e.g., Slow, Typical, Fast)." .

eda:VoltageCorner a owl:Class ;
    rdfs:subClassOf eda:Corner ;
    rdfs:label "Voltage Corner" ;
    rdfs:comment "Supply voltage variation corner." .

eda:TemperatureCorner a owl:Class ;
    rdfs:subClassOf eda:Corner ;
    rdfs:label "Temperature Corner" ;
    rdfs:comment "Operating temperature variation corner." .

###### Analyses and Metrics ######

eda:Analyses a owl:Class ;
    rdfs:label "Analyses" ;
    rdfs:comment "Collection of different analysis results." .

eda:TimingAnalysis a owl:Class ;
    rdfs:subClassOf eda:Analyses ;
    rdfs:label "Timing Analysis" ;
    rdfs:comment "Timing analysis results." .

eda:SetupTimingAnalysis a owl:Class ;
    rdfs:subClassOf eda:TimingAnalysis ;
    rdfs:label "Setup Timing Analysis" ;
    rdfs:comment "Setup timing analysis results." .

eda:HoldTimingAnalysis a owl:Class ;
    rdfs:subClassOf eda:TimingAnalysis ;
    rdfs:label "Hold Timing Analysis" ;
    rdfs:comment "Hold timing analysis results." .

eda:PowerAnalysis a owl:Class ;
    rdfs:subClassOf eda:Analyses ;
    rdfs:label "Power Analysis" ;
    rdfs:comment "Power analysis results." .

eda:AreaAnalysis a owl:Class ;
    rdfs:subClassOf eda:Analyses ;
    rdfs:label "Area Analysis" ;
    rdfs:comment "Area analysis results." .

eda:ViolationAnalysis a owl:Class ;
    rdfs:subClassOf eda:Analyses ;
    rdfs:label "Violation Analysis" ;
    rdfs:comment "Design rule and electrical violations analysis." .

eda:TimingMetrics a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Timing Metric" ;
    rdfs:comment "Timing-related metric (e.g., WNS, TNS, setup/hold slack)." .

eda:startpoint a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "startpoint" .

eda:endpoint a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "endpoint" .

eda:worst_arrival_time a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "worst arrival time" .

eda:worst_slack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "worst slack" .

eda:total_negative_slack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "total negative slack" .

eda:no_of_timing_paths a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of timing paths" .

eda:no_of_slack_violations a owl:DatatypeProperty ;
    rdfs:domain eda:TimingMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of slack violations" .

eda:PowerMetrics a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Power Metric" ;
    rdfs:comment "Power-related metric (e.g., leakage, switching, total power)." .

eda:combinational_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "combinational power" .

eda:sequential_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "sequential power" .

eda:macro_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "macro power" .

eda:internal_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "internal power" .

eda:switching_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "switching power" .

eda:leakage_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "leakage power" .

eda:total_power a owl:DatatypeProperty ;
    rdfs:domain eda:PowerMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "total power" .

eda:AreaMetrics a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Area Metric" ;
    rdfs:comment "Area-related metric (e.g., die area, core area, utilization)." .

eda:combinational_cell_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "combinational cell area" .

eda:sequential_cell_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "sequential cell area" .

eda:buffer_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "buffer area" .

eda:inverter_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "inverter area" .

eda:filler_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "filler area" .

eda:tap_cell_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "tap cell area" .

eda:diode_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "diode area" .

eda:macro_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "macro area" .

eda:cell_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "cell area" .

eda:total_area a owl:DatatypeProperty ;
    rdfs:domain eda:AreaMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "total area" .

eda:ViolationMetric a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Violation Metric" ;
    rdfs:comment "Metrics tracking counts or severity of design rule or electrical violations." .

eda:CellMetrics a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "CellMetrics" ;
    rdfs:comment "CellMetrics description." .

eda:no_of_combinational_cells a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of combinational cells" .

eda:no_of_sequential_cells a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of sequential cells" .

eda:no_of_buffers a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of buffers" .

eda:no_of_inverters a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of inverters" .

eda:no_of_fillers a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of fillers" .

eda:no_of_tap_cells a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of tap cells" .

eda:no_of_diodes a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of diodes" .

eda:no_of_macros a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of macros" .

eda:no_of_total_cells a owl:DatatypeProperty ;
    rdfs:domain eda:CellMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "no of total cells" .

### Entity: ClockTree
eda:ClockTree a owl:Class ;
    rdfs:subClassOf eda:Netlist ;
    rdfs:label "ClockTree" ;
    rdfs:comment "ClockTree description." .

eda:clock_source a owl:DatatypeProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range xsd:string ;
    rdfs:label "clock source" .

eda:no_of_buffers a owl:DatatypeProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range xsd:int ;
    rdfs:label "no of buffers" .

eda:no_of_clock_sinks a owl:DatatypeProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range xsd:int ;
    rdfs:label "no of clock sinks" .

eda:clock_tree_ports a owl:ObjectProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range eda:Port ;
    rdfs:label "ports" .

eda:clock_tree_instances a owl:ObjectProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range eda:Instance ;
    rdfs:label "instances" .

eda:clock_tree_nets a owl:ObjectProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range eda:Net ;
    rdfs:label "interconnects" .

eda:clock_tree_pins a owl:ObjectProperty ;
    rdfs:domain eda:ClockTree ;
    rdfs:range eda:Pin ;
    rdfs:label "pins" .


###### Physical Design Subprocesses ######

eda:Placement a owl:Class ;
    rdfs:subClassOf eda:PhysicalDesign ;
    rdfs:label "Placement" ;
    rdfs:comment "The subprocess of assigning physical locations to circuit elements" .

eda:GlobalPlacement a owl:Class ;
    rdfs:subClassOf eda:Placement ;
    rdfs:label "Global Placement" .

eda:DetailedPlacement a owl:Class ;
    rdfs:subClassOf eda:Placement ;
    rdfs:label "Detailed Placement" .

eda:Floorplanning a owl:Class ;
    rdfs:subClassOf eda:PhysicalDesign ;
    rdfs:label "Floorplanning" ;
    rdfs:comment "Planning the physical arrangement of blocks on the chip" .

eda:Routing a owl:Class ;
    rdfs:subClassOf eda:PhysicalDesign ;
    rdfs:label "Routing" ;
    rdfs:comment "Creating physical connections between circuit elements" .

eda:GlobalRouting a owl:Class ;
    rdfs:subClassOf eda:Routing ;
    rdfs:label "Global Routing" .

eda:DetailedRouting a owl:Class ;
    rdfs:subClassOf eda:Routing ;
    rdfs:label "Detailed Routing" .

eda:ClockTreeSynthesis a owl:Class ;
    rdfs:subClassOf eda:PhysicalDesign ;
    rdfs:label "Clock Tree Synthesis" ;
    rdfs:comment "Designing the clock distribution network" .

eda:ParasiticExtraction a owl:Class ;
    rdfs:subClassOf eda:EDAProcess ;
    rdfs:label "Parasitic Extraction" ;
    rdfs:comment "The process of extracting resistance and capacitance from a layout" .

###### Verification Subprocesses ######

eda:Simulation a owl:Class ;
    rdfs:subClassOf eda:Verification ;
    rdfs:label "Simulation" ;
    rdfs:comment "Testing the design using input stimuli" .

eda:FormalVerification a owl:Class ;
    rdfs:subClassOf eda:Verification ;
    rdfs:label "Formal Verification" ;
    rdfs:comment "Mathematically proving design correctness" .

eda:DesignRuleChecking a owl:Class ;
    rdfs:subClassOf eda:Verification ;
    rdfs:label "Design Rule Checking" ;
    rdfs:comment "Ensuring the layout adheres to manufacturing rules" .

eda:TimingSignoff a owl:Class ;
    rdfs:subClassOf eda:Verification ;
    rdfs:label "Timing Signoff" ;
    rdfs:comment "The process of final timing verification using static timing analysis" .

eda:LayoutVsSchematic a owl:Class ;
    rdfs:subClassOf eda:Verification ;
    rdfs:label "Layout vs. Schematic (LVS)" ;
    rdfs:comment "The process of verifying layout matches the netlist" .

###### Logical Synthesis Subprocesses ######

eda:TechnologyMapping a owl:Class ;
    rdfs:subClassOf eda:LogicalSynthesis ;
    rdfs:label "Technology Mapping" ;
    rdfs:comment "Mapping logic to a specific technology library" .

eda:Optimization a owl:Class ;
    rdfs:subClassOf eda:LogicalSynthesis ;
    rdfs:label "Optimization" ;
    rdfs:comment "Improving the netlist for area, power, or timing" .

###### Tools ######

eda:SynthesisTool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Synthesis Tool" ;
    rdfs:comment "A tool responsible for logic synthesis" .

eda:PlacementTool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Placer" ;
    rdfs:comment "A tool responsible for assigning physical locations to circuit elements" .

eda:RoutingTool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Router" ;
    rdfs:comment "A tool responsible for global routing to estimate wire paths" .

eda:STATool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Static Timing Analysis Tool" ;
    rdfs:comment "A tool responsible for analyzing and optimizing timing paths" .

eda:CTSTool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Clock Tree Synthesis" ;
    rdfs:comment "A tool responsible for synthesizing Clock Tree" .

###### Design Artifacts ######

eda:Design a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Design" ;
    rdfs:comment "The integrated circuit design entity undergoing the EDA process." .

eda:RTL a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Register Transfer Level" ;
    rdfs:comment "High-level description of a digital circuit" .

eda:Netlist a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Netlist" ;
    rdfs:comment "Collection of instances and connections." .

eda:Layout a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Layout" ;
    rdfs:comment "The physical representation of the chip, evolving through physical design" .

eda:OptimizedLayout a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ; 
    rdfs:label "Optimized Layout" ;
    rdfs:comment "A layout optimized for wirelength, routability, and timing" .

eda:GDSII a owl:Class ;
    rdfs:subClassOf eda:Layout ;
    rdfs:label "GDSII" ;
    rdfs:comment "Final layout format ready for manufacturing" .

eda:Mask a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Mask" ;
    rdfs:comment "A physical or virtual mask used in lithography" .

eda:SDC a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Synopsys Design Constraints (SDC)" ;
    rdfs:comment "Timing constraints file for synthesis and STA." .

eda:TechnologyLibrary a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Technology Library" ;
    rdfs:comment "Files defining process technology (e.g., LEF, techfile)" .

eda:VerificationReport a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Verification Report" ;
    rdfs:comment "Output artifact of verification processes (e.g., DRC Report, LVS Report, Timing Report)." .

###### Design Structure Elements ######

eda:Instance a owl:Class ;
    rdfs:label "Instance" ;
    rdfs:comment "An instantiated occurrence of a library cell or macro within the design." .

eda:Macro a owl:Class ;
    rdfs:subClassOf eda:Instance ;
    rdfs:label "Macro" ;
    rdfs:comment "A large pre-designed block (e.g., memory, processor core) instantiated in the design." .

eda:Port a owl:Class ;
    rdfs:label "Port" ;
    rdfs:comment "An external connection point of the top-level design or a hierarchical block." .

eda:SignalPort a owl:Class ;
    rdfs:subClassOf eda:Port ;
    rdfs:comment "A port that transmits logical or timing-related information." .

eda:Direction a owl:Class ; 
    rdfs:comment "Enumeration for Pin direction (Input, Output, InOut)." .

eda:PinFunction a owl:Class ; 
    rdfs:comment "Enumeration for Pin function (Signal, Power, Ground, Clock, etc.)." .

eda:Net a owl:Class ;
    rdfs:label "Net" ;
    rdfs:comment "A collection of electrically connected pins and wires." .

eda:SignalNet a owl:Class ;
    rdfs:subClassOf eda:Net ;
    rdfs:label "Signal Net" .

eda:PowerNet a owl:Class ;
    rdfs:subClassOf eda:Net ;
    rdfs:label "Power Net" ;
    rdfs:comment "Net that distributes power (e.g., VDD, VSS, or analog supplies)" .

### Entity: Wire
eda:Wire a owl:Class ;
    rdfs:label "Wire" ;
    rdfs:comment "Wire description." .

eda:name a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

eda:length a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "length" .

eda:x1 a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "x1" .

eda:y1 a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "y1" .

eda:x2 a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "x2" .

eda:y2 a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "y2" .

eda:midpoint_x a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "midpoint x" .

eda:midpoint_y a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "midpoint y" .

eda:rudy a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "rudy" .

eda:resistance a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "resistance" .

eda:capacitance a owl:DatatypeProperty ;
    rdfs:domain eda:Wire ;
    rdfs:range xsd:float ;
    rdfs:label "capacitance" .

eda:Pin a owl:Class ;
    rdfs:label "Pin" ;
    rdfs:comment "A connection point on an instance or a port." .

eda:SignalPin a owl:Class ;
    rdfs:subClassOf eda:Pin , [
            a owl:Restriction ;
            owl:onProperty eda:connectsTo ;
            owl:allValuesFrom eda:SignalNet
    ] ;
    rdfs:comment "Pin that transmits logical or timing-related information." .

eda:PowerPin a owl:Class ;
    rdfs:subClassOf eda:Pin, [
        a owl:Restriction ;
        owl:onProperty eda:connectsTo ;
        owl:allValuesFrom eda:PowerNet
    ] ;
    rdfs:comment "Pin that delivers energy (e.g., VDD, VSS)." .

eda:GroundPin a owl:Class ;
    rdfs:subClassOf eda:PowerPin ;
    rdfs:label "Ground Pin" .

eda:VoltageSupplyPin a owl:Class ;
    rdfs:subClassOf eda:PowerPin ;
    rdfs:label "Voltage Supply Pin" .

###### Library Structure Classes ######

eda:Library a owl:Class ;
    rdfs:label "Library" ;
    rdfs:comment "A collection of characterized cells (LibCells) and technology information used in design." .

eda:OperatingCondition a owl:Class ;
    rdfs:label "Operating Condition" ;
    rdfs:comment "A specific condition (PVT) under which library cells are characterized." .

eda:LibCell a owl:Class ;
    rdfs:label "Library Cell" ;
    rdfs:comment "A standard cell, macro, or IO cell defined in a library." .

eda:LeakagePower a owl:Class ;
    rdfs:label "Leakage Power Specification" ;
    rdfs:comment "Leakage power value for a LibCell under specific conditions." .

eda:LibPin a owl:Class ;
    rdfs:label "Library Pin" ;
    rdfs:comment "A pin definition within a library cell." .

eda:LibArc a owl:Class ;
    rdfs:label "Library Arc" ;
    rdfs:comment "A timing or power characterization arc (e.g., input pin to output pin delay) within a library cell." .

eda:PowerArc a owl:Class ;
    rdfs:subClassOf eda:LibArc ;
    rdfs:label "Power Arc" ;
    rdfs:comment "Power arc in a library cell." .

eda:TimingArc a owl:Class ;
    rdfs:subClassOf eda:LibArc ;
    rdfs:label "Timing Arc" ;
    rdfs:comment "Timing arc in a library cell." .

eda:LUT a owl:Class ;
    rdfs:label "Lookup Table (LUT)" ;
    rdfs:comment "A table used to represent complex timing or power characteristics, often associated with LibArcs." .

eda:Template a owl:Class ;
    rdfs:label "LUT Template" ;
    rdfs:comment "Defines the structure (indices) for a type of Lookup Table." .

eda:DelayTemplate a owl:Class ;
    rdfs:subClassOf eda:Template ;
    rdfs:label "Delay Template" ;
    rdfs:comment "Template for delay look-up tables." .

eda:PowerTemplate a owl:Class ;
    rdfs:subClassOf eda:Template ;
    rdfs:label "Power Template" ;
    rdfs:comment "Template for power look-up tables." .

###### Technology-Related Classes ######

eda:TechnologyArtifact a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Technology Artifact" ;
    rdfs:comment "An artifact defining manufacturing process rules, layers, and capabilities (e.g., LEF file, techfile)." .

eda:TechLEF a owl:Class ;
    rdfs:subClassOf eda:TechnologyArtifact ;
    rdfs:label "Technology LEF" ;
    rdfs:comment "Library Exchange Format (LEF) file defining technology parameters like layers, vias, site, and macro abstracts." .

eda:Layer a owl:Class ;
    rdfs:label "Layer" ;
    rdfs:comment "Represents a processing layer defined in the technology (e.g., metal layer, via layer, poly layer)." .

eda:RoutingLayer a owl:Class ;
    rdfs:subClassOf eda:Layer ;
    rdfs:label "Routing Layer" ;
    rdfs:comment "Specification for a metal routing layer in the technology." .

eda:CutLayer a owl:Class ;
    rdfs:subClassOf eda:Layer ;
    rdfs:label "Cut Layer" ;
    rdfs:comment "Specification for a via or cut layer connecting other layers." .

eda:Shape a owl:Class ;
    rdfs:label "Shape" ;
    rdfs:comment "A geometric shape (e.g., rectangle, polygon) used in layout or library definitions." .

###### Timing Graph Concepts ######

eda:TimingGraph a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Timing Graph" ;
    rdfs:comment "A directed graph representing timing paths and constraints in a digital circuit." .

eda:TimingNode a owl:Class ;
    rdfs:label "Timing Node" ;
    rdfs:comment "A vertex in the timing graph, typically representing a circuit pin or port." .

eda:TimingEdge a owl:Class ;
    rdfs:label "Timing Edge" ;
    rdfs:comment "A directed edge in the timing graph, representing signal propagation delay or a constraint check." .

eda:TimingPath a owl:Class ;
    rdfs:label "Timing Path" ;
    rdfs:comment "A sequence of connected timing nodes and edges from a startpoint to an endpoint, analyzed for timing." .

eda:ClockDomain a owl:Class ;
    rdfs:label "Clock Domain" ;
    rdfs:comment "A region of the design controlled by a specific clock or set of related clocks." .

eda:StartPoint a owl:Class ;
    rdfs:subClassOf eda:TimingNode ;
    rdfs:label "Start Point" ;
    rdfs:comment "A timing node where a timing path begins (e.g., clock pin of a flip-flop, input port)." .

eda:EndPoint a owl:Class ;
    rdfs:subClassOf eda:TimingNode ;
    rdfs:label "End Point" ;
    rdfs:comment "A timing node where a timing path terminates (e.g., data input of a flip-flop, output port)." .

eda:IntermediatePoint a owl:Class ;
    rdfs:subClassOf eda:TimingNode ;
    rdfs:label "Intermediate Point" ;
    rdfs:comment "A timing node along a path that is neither a start point nor an end point (e.g., intermediate pin in combinational logic)." .

eda:CellDelay a owl:Class ;
    rdfs:subClassOf eda:TimingEdge ;
    rdfs:label "Cell Delay Edge" ;
    rdfs:comment "Edge representing signal propagation delay through a logic cell." .

eda:NetDelay a owl:Class ;
    rdfs:subClassOf eda:TimingEdge ;
    rdfs:label "Net Delay Edge" ;
    rdfs:comment "Edge representing signal propagation delay through interconnect (nets/wires)." .

eda:SetupCheck a owl:Class ;
    rdfs:subClassOf eda:TimingEdge ;
    rdfs:label "Setup Check Edge" ;
    rdfs:comment "Edge representing a setup timing constraint check at an endpoint." .

eda:HoldCheck a owl:Class ;
    rdfs:subClassOf eda:TimingEdge ;
    rdfs:label "Hold Check Edge" ;
    rdfs:comment "Edge representing a hold timing constraint check at an endpoint." .

eda:startpoint a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:string ;
    rdfs:label "startpoint" .

eda:endpoint a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:string ;
    rdfs:label "endpoint" .

eda:path_type a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:string ;
    rdfs:label "path type" .

eda:arrival_time a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:float ;
    rdfs:label "arrival time" .

eda:required_time a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:float ;
    rdfs:label "required time" .

eda:slack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:float ;
    rdfs:label "slack" .

eda:no_of_gates a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:integer ;
    rdfs:label "number of gates" .

eda:is_critical_path a owl:DatatypeProperty ;
    rdfs:domain eda:TimingPath ;
    rdfs:range xsd:boolean ;
    rdfs:label "is critical path" .


###### Clock Classes ######

eda:Clock a owl:Class ;
    rdfs:label "Clock" ;
    rdfs:comment "A periodic signal that synchronizes circuit operation, defined in constraints (e.g., SDC)." .

eda:GeneratedClock a owl:Class ;
    rdfs:subClassOf eda:Clock ;
    rdfs:label "Generated Clock" ;
    rdfs:comment "A clock derived from another clock through logic (e.g., frequency dividers/multipliers)." .

eda:PrimaryClock a owl:Class ;
    rdfs:subClassOf eda:Clock ;
    rdfs:label "Primary Clock" ;
    rdfs:comment "A clock defined at a primary input port or pin of the design." .

eda:VirtualClock a owl:Class ;
    rdfs:subClassOf eda:Clock ;
    rdfs:label "Virtual Clock" ;
    rdfs:comment "A clock used for timing analysis (e.g., for IO timing) but not physically present or propagated in the design." .

###### Constraint Classes ######

eda:Constraints a owl:Class ;
    rdfs:label "Constraints" ;
    rdfs:comment "Design constraints." .

eda:TimingConstraint a owl:Class ;
    rdfs:label "Timing Constraint" ;
    rdfs:comment "A constraint specified for timing analysis (e.g., in SDC)." .

eda:ClockConstraint a owl:Class ;
    rdfs:subClassOf eda:TimingConstraint ;
    rdfs:label "Clock Constraint" ;
    rdfs:comment "A constraint applied to one or more clocks (e.g., latency, uncertainty)." .

eda:ClockLatency a owl:Class ;
    rdfs:subClassOf eda:ClockConstraint ;
    rdfs:label "Clock Latency" ;
    rdfs:comment "Specifies the delay from the clock source definition point to specific points in the clock network (source or network latency)." .

eda:ClockUncertainty a owl:Class ;
    rdfs:subClassOf eda:ClockConstraint ;
    rdfs:label "Clock Uncertainty" ;
    rdfs:comment "Models the variability in clock arrival times due to jitter, skew specified for inter-clock paths, or timing margins." .

eda:ClockTransition a owl:Class ;
    rdfs:subClassOf eda:ClockConstraint ;
    rdfs:label "Clock Transition" ;
    rdfs:comment "Specifies the maximum rise/fall time constraint for a clock signal." .

eda:ClockGroup a owl:Class ;
    rdfs:label "Clock Group" ;
    rdfs:comment "A collection of clocks grouped for constraint purposes (e.g., asynchronous, exclusive)." .

eda:ClockRelationship a owl:Class ;
    rdfs:label "Clock Relationship" ;
    rdfs:comment "A defined timing relationship between two or more clocks or clock groups." .

eda:SynchronousRelationship a owl:Class ;
    rdfs:subClassOf eda:ClockRelationship ;
    rdfs:label "Synchronous Relationship" ;
    rdfs:comment "Indicates clocks that are considered synchronous for timing analysis." .

eda:AsynchronousRelationship a owl:Class ;
    rdfs:subClassOf eda:ClockRelationship ;
    rdfs:label "Asynchronous Relationship" ;
    rdfs:comment "Indicates clocks that have no fixed phase relationship; paths between them are often treated as false paths by default unless specified otherwise." .

eda:MutuallyExclusiveRelationship a owl:Class ;
    rdfs:subClassOf eda:ClockRelationship ;
    rdfs:label "Mutually Exclusive Relationship" ;
    rdfs:comment "Indicates clock domains or groups that are logically or physically exclusive (paths between them are not timed)." .






eda:PathExceptionConstraint a owl:Class ;
    rdfs:subClassOf eda:TimingConstraint ;
    rdfs:label "Path Exception Constraint" ;
    rdfs:comment "A constraint that overrides default timing analysis for specific paths." .

eda:MultiCyclePath a owl:Class ;
    rdfs:subClassOf eda:PathExceptionConstraint ;
    rdfs:label "Multi-Cycle Path Constraint" ;
    rdfs:comment "Allows a path multiple clock cycles for data propagation." .

eda:SetupMultiCycle a owl:Class ;
    rdfs:subClassOf eda:MultiCyclePath ;
    rdfs:label "Setup Multi-Cycle" ;
    rdfs:comment "Relaxed setup check allowing data to arrive after multiple cycles." .

eda:HoldMultiCycle a owl:Class ;
    rdfs:subClassOf eda:MultiCyclePath ;
    rdfs:label "Hold Multi-Cycle" ;
    rdfs:comment "Modified hold check accounting for multi-cycle setup paths." .

eda:FalsePath a owl:Class ;
    rdfs:subClassOf eda:PathExceptionConstraint ;
    rdfs:label "False Path Constraint" ;
    rdfs:comment "Identifies a timing path that is logically or functionally impossible and should not be analyzed." .

eda:MaxDelay a owl:Class ;
    rdfs:subClassOf eda:PathExceptionConstraint ;
    rdfs:label "Maximum Delay Constraint" ;
    rdfs:comment "Specifies the maximum allowable propagation delay on a specific path or set of paths." .

eda:MinDelay a owl:Class ;
    rdfs:subClassOf eda:PathExceptionConstraint ;
    rdfs:label "Minimum Delay Constraint" ;
    rdfs:comment "Specifies the minimum required propagation delay on a specific path or set of paths." .

###### Circuit Graph Concepts ######

eda:CircuitGraph a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Circuit Graph" ;
    rdfs:comment "Graph-based representation of a circuit, often used as input for ML models." .

###### Decision Points and Flow Control ######

eda:DecisionPoint a owl:Class ;
    rdfs:subClassOf eda:EDAProcess ;
    rdfs:label "Decision Point" ;
    rdfs:comment "A point in the EDA flow where an agent must evaluate conditions and select a subsequent process or action." .

eda:FallbackStrategy a owl:Class ;
    rdfs:label "Fallback Strategy" ;
    rdfs:comment "An alternative approach or process to be applied when a primary method fails or does not converge." .

###### Agent Actions and Heuristics ######

eda:AgentAction a owl:Class ;
    rdfs:label "EDA Agent Action" ;
    rdfs:comment "A concrete action that an agent can take within an EDA process, often involving tool commands." .

eda:InsertBuffer a owl:Class ;
    rdfs:subClassOf eda:AgentAction ;
    rdfs:label "Insert Buffer" ;
    rdfs:comment "Action to insert a buffer instance on a net, typically to improve timing." .

eda:ResizeCell a owl:Class ;
    rdfs:subClassOf eda:AgentAction ;
    rdfs:label "Resize Cell" ;
    rdfs:comment "Action to change the library cell type (size/strength) of an instance to affect timing, power, or area." .

eda:HeuristicRule a owl:Class ;
    rdfs:label "Heuristic Rule" ;
    rdfs:comment "An encoded piece of expert knowledge or rule-of-thumb that guides agent decision-making." .

eda:SuccessMetric a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Success Metric" ;
    rdfs:comment "A quantifiable measure used to determine if an agent's intervention or action was successful in achieving its local goal." .

###### Tool Commands and Resources ######

eda:ToolCommand a owl:Class ;
    rdfs:label "Tool Command" ;
    rdfs:comment "A specific command or script fragment for an EDA tool that implements an abstract agent action." .

eda:ResourceRequirement a owl:Class ;
    rdfs:label "Resource Requirement" ;
    rdfs:comment "Specifies the computational resources needed to execute a process or tool command." .

eda:ErrorCondition a owl:Class ;
    rdfs:label "Error Condition" ;
    rdfs:comment "A potential failure mode or error state encountered during an EDA process." .

eda:DesignPattern a owl:Class ;
    rdfs:label "Design Pattern (EDA)" ;
    rdfs:comment "A documented, proven approach or technique to address a common problem in EDA (e.g., 'timing optimization pattern', 'congestion mitigation pattern')." .

###### System-Level Design Classes ######

eda:SystemDesign a owl:Class ;
    rdfs:subClassOf eda:Design ;
    rdfs:label "System Design" ;
    rdfs:comment "Represents a multi-component system design, typically involving multiple chiplets, interposers, and packaging." .

eda:Chiplet a owl:Class ;
    rdfs:subClassOf eda:Design ;
    rdfs:label "Chiplet" ;
    rdfs:comment "A distinct silicon die, potentially designed independently, intended for integration into a larger SystemDesign via advanced packaging." .

eda:BottomDie a owl:Class ;
    rdfs:subClassOf eda:Chiplet ;
    rdfs:label "Bottom Die" ;
    rdfs:comment "A base die, potentially active, in a 3D stack onto which other chiplets are mounted." .

eda:PhysicalSubstrate a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "Physical Substrate" ;
    rdfs:comment "A physical substrate carrying or connecting dies (e.g., Interposer, Package Substrate)." .

eda:Interposer a owl:Class ;
    rdfs:subClassOf eda:PhysicalSubstrate ;
    rdfs:label "Interposer" ;
    rdfs:comment "A substrate, often silicon or organic, used to provide high-density interconnect between multiple chiplets." .

eda:PackageSubstrate a owl:Class ;
    rdfs:subClassOf eda:PhysicalSubstrate ;
    rdfs:label "Package Substrate" ;
    rdfs:comment "The main package substrate, typically organic, holding the interposer or dies and providing connections to the external system." .

###### Interconnect Elements ######

eda:InterconnectElement a owl:Class ;
    rdfs:label "Interconnect Element" ;
    rdfs:comment "A physical element providing electrical and mechanical connection between dies or between a die and a substrate." .

eda:MicroBump a owl:Class ;
    rdfs:subClassOf eda:InterconnectElement ;
    rdfs:label "Micro-bump (µbump)" ;
    rdfs:comment "Small solder bumps used for high-density die-to-die or die-to-interposer connections." .

eda:SolderBump a owl:Class ;
    rdfs:subClassOf eda:InterconnectElement ;
    rdfs:label "Solder Bump" ;
    rdfs:comment "A solder ball used for connections." .

eda:C4Bump a owl:Class ;
    rdfs:subClassOf eda:SolderBump ;
    rdfs:label "C4 Bump" ;
    rdfs:comment "Controlled Collapse Chip Connection bump, typically larger bumps used for connecting interposer/die to a package substrate." .

eda:HybridBondingInterface a owl:Class ;
    rdfs:subClassOf eda:InterconnectElement ;
    rdfs:label "Hybrid Bonding Interface" ;
    rdfs:comment "Direct copper-to-copper bonding interface enabling very fine pitch die-to-die connections." .

###### System-Level Interfaces and Connections ######

eda:Interface a owl:Class ;
    rdfs:label "Interface" ;
    rdfs:comment "A defined boundary or collection of connections between components (e.g., chiplets, interposer)." .

eda:ChipletInterface a owl:Class ;
    rdfs:subClassOf eda:Interface ;
    rdfs:label "Chiplet Interface" ;
    rdfs:comment "The set of external connection points and their characteristics defined for a specific Chiplet." .

eda:InterfacePin a owl:Class ;
    rdfs:subClassOf eda:Pin ;
    rdfs:label "Interface Pin" ;
    rdfs:comment "A Pin specifically designated as part of an external ChipletInterface." .

eda:SystemLevelNet a owl:Class ;
    rdfs:subClassOf eda:Net ;
    rdfs:label "System-Level Net" ;
    rdfs:comment "A net that spans across multiple chiplets and/or the interposer." .

###### System-Level Processes ######

eda:SystemPartitioning a owl:Class ;
    rdfs:subClassOf eda:EDAProcess ;
    rdfs:label "System Partitioning" ;
    rdfs:comment "The process of dividing the functionality and logic of a SystemDesign across multiple Chiplets." .

eda:MinCutPartitioning a owl:Class ;
    rdfs:subClassOf eda:SystemPartitioning ;
    rdfs:label "Min-Cut Partitioning" ;
    rdfs:comment "A specific SystemPartitioning strategy aiming to minimize the number or bandwidth of connections required between the resulting Chiplets." .

eda:SystemPlacement a owl:Class ;
    rdfs:subClassOf eda:Placement ;
    rdfs:label "System Placement" ;
    rdfs:comment "The process of determining the physical locations of multiple Chiplets onto an Interposer, BottomDie, or PackageSubstrate." .

eda:InterconnectRouting a owl:Class ;
    rdfs:subClassOf eda:Routing ;
    rdfs:label "Interconnect Routing" ;
    rdfs:comment "The process of creating physical connections (routes) between Chiplets, typically on an Interposer or within a 3D stack." .

eda:SystemTimingAnalysis a owl:Class ;
    rdfs:subClassOf eda:TimingSignoff ;
    rdfs:label "System-Level Timing Analysis" ;
    rdfs:comment "Static Timing Analysis performed across chiplet boundaries, considering interconnect delays between chiplets." .

eda:InterconnectOptimization a owl:Class ;
    rdfs:subClassOf eda:Optimization ;
    rdfs:label "Interconnect Optimization" ;
    rdfs:comment "The process of optimizing the performance (timing, power) of inter-chiplet connections." .

eda:SystemOptimizationLoop a owl:Class ;
    rdfs:subClassOf eda:EDAProcess ;
    rdfs:label "System Optimization Loop" ;
    rdfs:comment "An iterative process encompassing system placement, interconnect routing, system-level analysis (STA, Power, Thermal), and interconnect optimization to meet system PPA targets." .

###### System-Level Metrics ######

eda:ThermalMetric a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Thermal Metric" ;
    rdfs:comment "Metrics related to temperature or heat flow." .

eda:PowerDeliveryNetworkMetric a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Power Delivery Network Metric" ;
    rdfs:comment "Metrics related to the quality of the power distribution across the system (e.g., system-level IR drop)." .

eda:InterconnectBandwidth a owl:Class ;
    rdfs:subClassOf eda:Metric ;
    rdfs:label "Interconnect Bandwidth" ;
    rdfs:comment "The data transfer rate achievable over the inter-chiplet interconnect." .

###### Materials ######

eda:Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:comment "A physical material used in manufacturing, packaging, or assembly." .

eda:Underfill a owl:Class ;
    rdfs:subClassOf eda:Material ;
    rdfs:label "Underfill" ;
    rdfs:comment "Material dispensed between connected dies/substrates to provide mechanical stability and protection for interconnect elements." .

###### Semiconductor Manufacturing Process Classes ######

eda:SemiconductorManufacturingProcess a owl:Class ;
    rdfs:subClassOf eda:EDAProcess ;
    rdfs:label "Semiconductor Manufacturing Process" ;
    rdfs:comment "A process in semiconductor manufacturing covering both front-end and back-end operations." .

eda:SubstratePreparation a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Substrate Preparation" ;
    rdfs:comment "Processes involved in creating and preparing the wafer, including crystal growth, slicing, and polishing." .

eda:FilmFormation a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Film Formation" ;
    rdfs:comment "Processes for depositing thin films on the wafer (e.g., oxidation, deposition)." .

eda:Patterning a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Patterning" ;
    rdfs:comment "Processes for transferring patterns onto the wafer via lithography and subsequent etching." .

eda:Doping a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Doping" ;
    rdfs:comment "Processes for introducing impurities into the semiconductor to modify its electrical properties." .

eda:Planarization a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Planarization" ;
    rdfs:comment "Processes used to create a flat surface on the wafer, such as chemical mechanical planarization (CMP)." .

eda:CleaningAndSurfacePreparation a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Cleaning and Surface Preparation" ;
    rdfs:comment "Processes for cleaning and preparing the wafer surface for subsequent processing steps." .

eda:ThermalProcessing a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Thermal Processing" ;
    rdfs:comment "Processes involving heat treatments, including annealing and rapid thermal processing." .

eda:MetrologyAndInspection a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Metrology and Inspection" ;
    rdfs:comment "Processes for measuring and inspecting wafer properties and dimensions." .

eda:AdvancedModules a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Advanced Modules" ;
    rdfs:comment "Specialized processing modules used for emerging or advanced semiconductor structures." .

eda:BackEndProcesses a owl:Class ;
    rdfs:subClassOf eda:SemiconductorManufacturingProcess ;
    rdfs:label "Back-End Processes" ;
    rdfs:comment "Processes that occur after front-end fabrication, including metallization, packaging, and testing." .

###### Etching Processes ######

eda:Etching a owl:Class ;
    rdfs:subClassOf eda:Patterning ;
    rdfs:label "Etching" ;
    rdfs:comment "The process of removing material from the wafer to form patterns." .

eda:WetEtching a owl:Class ;
    rdfs:subClassOf eda:Etching ;
    rdfs:label "Wet Etching" ;
    rdfs:comment "Etching using liquid chemicals." .

eda:DryEtching a owl:Class ;
    rdfs:subClassOf eda:Etching ;
    rdfs:label "Dry Etching" ;
    rdfs:comment "Etching process that uses gaseous reactants or plasmas." .

eda:PlasmaEtching a owl:Class ;
    rdfs:subClassOf eda:DryEtching ;
    rdfs:label "Plasma Etching" ;
    rdfs:comment "A dry etching technique that utilizes plasma to remove material." .

eda:ReactiveIonEtching a owl:Class ;
    rdfs:subClassOf eda:DryEtching ;
    rdfs:label "Reactive Ion Etching" ;
    rdfs:comment "Dry etching using reactive ions generated in plasma to remove material." .

###### Object Properties (Relationships) ######

### Flow properties
eda:hasStage a owl:ObjectProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range eda:Stage ;
    rdfs:label "has Stage" .

### Process-related properties
eda:consumes a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:DesignArtifact ;
    rdfs:label "consumes" ;
    rdfs:comment "Relates a process to the artifact it consumes" .

eda:produces a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:DesignArtifact ;
    rdfs:label "produces" ;
    rdfs:comment "Relates a process to the artifact it produces" .

eda:precedes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "precedes" ;
    rdfs:comment "Indicates the sequential order of processes" .

eda:usesTool a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:Tool ;
    rdfs:label "uses tool" ;
    rdfs:comment "Relates a process to the tool it uses" .

eda:optimizes a owl:ObjectProperty ;
    rdfs:domain eda:ConcurrentPhysicalOptimization ;
    rdfs:range xsd:string ;
    rdfs:label "optimizes" ;
    rdfs:comment "Specifies the objectives optimized by the process" .

### Subprocess properties
eda:hasSubProcess a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "has subprocess" ;
    rdfs:comment "Relates a process to its subprocesses" .

eda:isPartOf a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "is part of" ;
    rdfs:comment "Relates a subprocess to its parent process" ;
    owl:inverseOf eda:hasSubProcess .

### Analysis view properties
eda:hasRCCorner a owl:ObjectProperty ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:RCCorner ;
    rdfs:label "has RC Corner" .

eda:hasLibCorner a owl:ObjectProperty ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:LibCorner ;
    rdfs:label "has Lib Corner" .

eda:hasMode a owl:ObjectProperty ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:Mode ;
    rdfs:label "has mode" ;
    rdfs:comment "Relates an analysis view to its functional/test mode." .

eda:hasProcessCorner a owl:ObjectProperty ;
    rdfs:subPropertyOf eda:hasOperatingCondition ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:ProcessCorner ;
    rdfs:label "has process corner" .

eda:hasVoltageCorner a owl:ObjectProperty ;
    rdfs:subPropertyOf eda:hasOperatingCondition ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:VoltageCorner ;
    rdfs:label "has voltage corner" .

eda:hasTemperatureCorner a owl:ObjectProperty ;
    rdfs:subPropertyOf eda:hasOperatingCondition ;
    rdfs:domain eda:AnalysisView ;
    rdfs:range eda:TemperatureCorner ;
    rdfs:label "has temperature corner" .

### Stage properties
eda:hasAnalyses a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:Analyses ;
    rdfs:label "has analyses" .

eda:hasNetlist a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:Netlist ;
    rdfs:label "has netlist" .

### Analysis properties
eda:hasTimingAnalysis a owl:ObjectProperty ;
    rdfs:domain eda:Analyses ;
    rdfs:range eda:TimingAnalysis ;
    rdfs:label "has timing analysis" .

eda:hasPowerAnalysis a owl:ObjectProperty ;
    rdfs:domain eda:Analyses ;
    rdfs:range eda:PowerAnalysis ;
    rdfs:label "has power analysis" .

eda:hasAreaAnalysis a owl:ObjectProperty ;
    rdfs:domain eda:Analyses ;
    rdfs:range eda:AreaAnalysis ;
    rdfs:label "has area analysis" .

eda:hasViolationAnalysis a owl:ObjectProperty ;
    rdfs:domain eda:Analyses ;
    rdfs:range eda:ViolationAnalysis ;
    rdfs:label "has violation analysis" .

### Design structure properties
eda:hasInstance a owl:ObjectProperty ;
    rdfs:domain eda:Netlist ;
    rdfs:range eda:Instance ;
    rdfs:label "has instance" .

eda:hasPort a owl:ObjectProperty ;
    rdfs:domain eda:Netlist ;
    rdfs:range eda:Port ;
    rdfs:label "has port" .

eda:hasNet a owl:ObjectProperty ;
    rdfs:domain eda:Netlist ;
    rdfs:range eda:Net ;
    rdfs:label "has net" .

eda:hasPin a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:Instance eda:Port) ] ;
    rdfs:range eda:Pin ;
    rdfs:label "has pin" .

eda:hasWire a owl:ObjectProperty ;
    rdfs:domain eda:Net ;
    rdfs:range eda:Wire ;
    rdfs:label "has wire" .

eda:hasVia a owl:ObjectProperty ;
    rdfs:domain eda:Net ;
    rdfs:range eda:Via ;
    rdfs:label "has via" .

eda:connectsTo a owl:ObjectProperty ;
    rdfs:domain eda:Pin ;
    rdfs:range eda:Net ;
    rdfs:label "connects to" ;
    rdfs:comment "Relates a pin to the net it belongs to." .

eda:belongsToInstance a owl:ObjectProperty ;
    rdfs:domain eda:Pin ;
    rdfs:range eda:Instance ;
    rdfs:label "belongs to instance" ;
    owl:inverseOf eda:hasPin .

### Library properties
eda:hasLibCell a owl:ObjectProperty ;
    rdfs:domain eda:Library ;
    rdfs:range eda:LibCell ;
    rdfs:label "has library cell" .

eda:hasTemplate a owl:ObjectProperty ;
    rdfs:domain eda:Library ;
    rdfs:range eda:Template ;
    rdfs:label "has template" .

eda:hasLibPin a owl:ObjectProperty ;
    rdfs:domain eda:LibCell ;
    rdfs:range eda:LibPin ;
    rdfs:label "has library pin" .

eda:hasLibArc a owl:ObjectProperty ;
    rdfs:domain eda:LibCell ;
    rdfs:range eda:LibArc ;
    rdfs:label "has library arc" .

eda:hasLeakagePowerSpec a owl:ObjectProperty ;
    rdfs:domain eda:LibCell ;
    rdfs:range eda:LeakagePower ;
    rdfs:label "has leakage power specification" .

eda:hasLUT a owl:ObjectProperty ;
    rdfs:domain eda:LibArc ;
    rdfs:range eda:LUT ;
    rdfs:label "has LUT" .

### Analysis context properties
eda:hasAnalysisView a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:Metric eda:Design) ] ;
    rdfs:range eda:AnalysisView ;
    rdfs:label "has Analysis View" ;
    rdfs:comment "Links a result (Metric) or the design state to the specific Analysis View under which it was obtained/evaluated." .

eda:hasOperatingCondition a owl:ObjectProperty ;
    rdfs:label "has operating condition" ;
    rdfs:comment "Relates a Library or analysis context (like AnalysisView) to the operating condition used." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            eda:Library
            eda:AnalysisView
        )
    ] ;
    rdfs:range eda:OperatingCondition .

### Metric properties
eda:hasMetric a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:Metric ;
    rdfs:label "has Metric" .

### Timing graph properties
eda:hasNode a owl:ObjectProperty ;
    rdfs:domain eda:TimingGraph ;
    rdfs:range eda:TimingNode ;
    rdfs:label "has node" ;
    rdfs:comment "Relates a timing graph to a timing node contained within it." .

eda:hasEdge a owl:ObjectProperty ;
    rdfs:domain eda:TimingGraph ;
    rdfs:range eda:TimingEdge ;
    rdfs:label "has edge" ;
    rdfs:comment "Relates a timing graph to a timing edge contained within it." .

eda:sourceNode a owl:ObjectProperty ;
    rdfs:domain eda:TimingEdge ;
    rdfs:range eda:TimingNode ;
    rdfs:label "source node" ;
    rdfs:comment "Relates a timing edge to its source node." .

eda:sinkNode a owl:ObjectProperty ;
    rdfs:domain eda:TimingEdge ;
    rdfs:range eda:TimingNode ;
    rdfs:label "sink node" ;
    rdfs:comment "Relates a timing edge to its sink node." .

eda:represents a owl:ObjectProperty ;
    rdfs:domain eda:TimingNode ;
    rdfs:range [ a owl:Class ; owl:unionOf(eda:SignalPin eda:SignalNet eda:SignalPort) ] ;
    rdfs:label "represents" ;  
    rdfs:comment "Links a timing node to the design element (pin, port, or net) it represents." .

### Clock properties
eda:sourceClock a owl:ObjectProperty ;
    rdfs:domain eda:GeneratedClock ;
    rdfs:range eda:Clock ;
    rdfs:label "source clock" ;
    rdfs:comment "The master clock from which a generated clock is derived." .

eda:clocksInGroup a owl:ObjectProperty ;
    rdfs:domain eda:ClockGroup ;
    rdfs:range eda:Clock ;
    rdfs:label "clocks in group" ;
    rdfs:comment "Relates a clock group to its member clocks." .

eda:fromClock a owl:ObjectProperty ;
    rdfs:domain eda:ClockRelationship ;
    rdfs:range eda:Clock ;
    rdfs:label "from clock" ;
    rdfs:comment "The source clock (or group) in a clock relationship constraint." .

eda:toClock a owl:ObjectProperty ;
    rdfs:domain eda:ClockRelationship ;
    rdfs:range eda:Clock ;
    rdfs:label "to clock" ;
    rdfs:comment "The destination clock (or group) in a clock relationship constraint." .

### Technology properties
eda:hasRoutingLayer a owl:ObjectProperty ;
    rdfs:domain eda:TechnologyArtifact ;
    rdfs:range eda:RoutingLayer ;
    rdfs:label "has routing layer" .

eda:hasCutLayer a owl:ObjectProperty ;
    rdfs:domain eda:TechnologyArtifact ;
    rdfs:range eda:CutLayer ;
    rdfs:label "has cut layer" .

eda:hasShape a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (eda:LibCell eda:LibPin eda:Wire eda:Via eda:Port)
    ] ;
    rdfs:range eda:Shape ;
    rdfs:label "has shape" .

### Circuit graph properties
eda:containsNet a owl:ObjectProperty ;
    rdfs:domain eda:CircuitGraph ;
    rdfs:range eda:Net ;
    rdfs:label "contains net" ;
    rdfs:comment "Relates a circuit graph to the nets represented within it." .

eda:containsInstance a owl:ObjectProperty ;
    rdfs:domain eda:CircuitGraph ;
    rdfs:range eda:Instance ;
    rdfs:label "contains instance" ;
    rdfs:comment "Relates a circuit graph to the instances represented within it." .

eda:containsPin a owl:ObjectProperty ;
    rdfs:domain eda:CircuitGraph ;
    rdfs:range eda:Pin ;
    rdfs:label "contains pin" ;
    rdfs:comment "Relates a circuit graph to the pins represented within it." .

### Decision point and flow control properties
eda:requiresIteration a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "requires iteration to" ;
    rdfs:comment "Indicates that a process may need to loop back to a previous process if certain conditions (e.g., convergence) are not met." .

eda:hasFallback a owl:ObjectProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range eda:FallbackStrategy ;
    rdfs:label "has fallback" ;
    rdfs:comment "Relates a process to its fallback strategies." .

### Heuristic rule properties
eda:recommendsAction a owl:ObjectProperty ;
    rdfs:domain eda:HeuristicRule ;
    rdfs:range eda:AgentAction ;
    rdfs:label "recommends action" ;
    rdfs:comment "The action recommended by a heuristic rule when its condition is met." .

### Tool command properties
eda:implementsAction a owl:ObjectProperty ;
    rdfs:domain eda:ToolCommand ;
    rdfs:range eda:AgentAction ;
    rdfs:label "implements action" ;
    rdfs:comment "Indicates that a tool command provides a concrete implementation for an abstract agent action." .

### System design properties
eda:aggregates a owl:ObjectProperty ;
    rdfs:label "aggregates" ;
    rdfs:domain eda:SystemDesign ;
    rdfs:range [ owl:unionOf (eda:Chiplet eda:Interposer eda:PackageSubstrate) ] ;
    rdfs:comment "Relates a system design to its primary constituent components." .


eda:mountedOn a owl:ObjectProperty ;
    rdfs:label "mounted on" ;
    rdfs:domain eda:Chiplet ;
    rdfs:range [ owl:unionOf (eda:Interposer eda:PackageSubstrate eda:BottomDie) ] ;
    rdfs:comment "Indicates the substrate or die a chiplet is physically placed upon." .

eda:connectsComponent a owl:ObjectProperty ;
    rdfs:label "connects component" ;
    rdfs:domain eda:InterconnectElement ;
    rdfs:range [ owl:unionOf (eda:Chiplet eda:Interposer eda:PackageSubstrate) ] ;
    rdfs:comment "Relates an interconnect element (like a bump) to a component (die or substrate) it is attached to." .

eda:usesInterconnect a owl:ObjectProperty ;
    rdfs:label "uses interconnect" ;
    rdfs:domain [ owl:unionOf (eda:Chiplet eda:Interposer eda:PackageSubstrate) ] ;
    rdfs:range eda:InterconnectElement ;
    owl:inverseOf eda:connectsComponent ;
    rdfs:comment "Relates a component to the interconnect elements used for its connections." .

eda:filledWith a owl:ObjectProperty ;
    rdfs:label "filled with" ;
    rdfs:domain eda:InterconnectElement ;
    rdfs:range eda:Underfill ;
    rdfs:comment "Indicates the underfill material used around an interconnect element." .

eda:partitionsInto a owl:ObjectProperty ;
    rdfs:label "partitions into" ;
    rdfs:domain eda:SystemPartitioning ;
    rdfs:range eda:Chiplet ;
    rdfs:comment "Relates the partitioning process to the resulting chiplets defines." .

eda:hasInterface a owl:ObjectProperty ;
    rdfs:label "has interface" ;
    rdfs:domain eda:Chiplet ;
    rdfs:range eda:ChipletInterface ;
    rdfs:comment "Links a chiplet to its defined external interface." .

eda:hasInterfacePin a owl:ObjectProperty ;
    rdfs:label "has interface pin" ;
    rdfs:domain eda:ChipletInterface ;
    rdfs:range eda:InterfacePin ;
    rdfs:comment "Links an interface definition to its specific pins." .

eda:mapsToInternalPin a owl:ObjectProperty ;
    rdfs:label "maps to internal pin" ;
    rdfs:domain eda:InterfacePin ;
    rdfs:range eda:Pin ;
    rdfs:comment "Links an interface pin to the corresponding internal pin of the chiplet's design." .

eda:crossesBoundaryOf a owl:ObjectProperty ;
    rdfs:label "crosses boundary of" ;
    rdfs:domain eda:SystemLevelNet ;
    rdfs:range eda:Chiplet ;
    rdfs:comment "Indicates which chiplet boundaries a system-level net crosses." .

eda:targetsInterconnect a owl:ObjectProperty ;
    rdfs:label "targets interconnect" ;
    rdfs:domain eda:InterconnectOptimization ;
    rdfs:range eda:SystemLevelNet ;
    rdfs:comment "Indicates that the optimization process focuses on inter-chiplet nets." .

eda:realizesLibCell a owl:ObjectProperty ;
    rdfs:label "realizes library cell" ;
    rdfs:comment "Links an instance in the design to the library cell it instantiates." ;
    rdfs:domain eda:Instance ;
    rdfs:range eda:LibCell .

eda:generates a owl:ObjectProperty ;
    rdfs:domain eda:Tool ;
    rdfs:range eda:DesignArtifact ;
    rdfs:label "generates" ;
    rdfs:comment "Relates a tool to the artifact it typically produces." .

eda:impacts a owl:ObjectProperty ;
    rdfs:label "impacts" ;
    rdfs:comment "Indicates that one parameter, metric, or entity causally affects another." .

eda:derivesFrom a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain eda:DesignArtifact ;
    rdfs:range eda:DesignArtifact ;
    rdfs:label "derives from" ;
    rdfs:comment "Indicates the parent version from which this design version was derived." .

###### Datatype Properties ######

### Flow properties
eda:timestamp a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:dateTime ;
    rdfs:label "timestamp" .

eda:version a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:Flow eda:DesignArtifact eda:Tool) ] ;
    rdfs:range xsd:string ;
    rdfs:label "version" .

eda:runtime a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:float ;
    rdfs:label "runtime" ;
    qudt:unit unit:Second .

eda:toolName a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:string ;
    rdfs:label "tool name" .

### Analysis view properties
eda:name a owl:DatatypeProperty ;
    rdfs:domain [
         a owl:Class ;
         owl:unionOf (
            eda:AnalysisView
            eda:Corner
            eda:Mode
            eda:Stage
            eda:Design
            eda:Instance
            eda:Port
            eda:Net
            eda:Pin
            eda:Library
            eda:LibCell
            eda:LibPin
            eda:LibArc
            eda:OperatingCondition
            eda:Template) ] ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

eda:rcx_file a owl:DatatypeProperty ;
    rdfs:domain eda:RCCorner ;
    rdfs:range xsd:anyURI ;
    rdfs:label "rcx file" .

eda:library_files a owl:DatatypeProperty ;
    rdfs:domain eda:LibCorner ;
    rdfs:range xsd:anyURI ;
    rdfs:label "library files" .

### Stage properties
eda:stageName a owl:DatatypeProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range xsd:string ;
    rdfs:label "stage name" .

### Timing analysis properties
eda:totalNegativeSlack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "Total Negative Slack" ;
    qudt:unit unit:NanoSecond .

eda:worstNegativeSlack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "Worst Negative Slack" ;
    qudt:unit unit:NanoSecond .

eda:worstSlack a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "Worst Slack" ;
    qudt:unit unit:NanoSecond .

eda:arrivalTimeOfCriticalPath a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "arrival time of critical path" ;
    qudt:unit unit:NanoSecond .

eda:requiredTimeOfCriticalPath a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "required time of critical path" ;
    qudt:unit unit:NanoSecond .

eda:worstEndpoint a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:string ;
    rdfs:label "worst endpoint" .

eda:violatingEndpointCount a owl:DatatypeProperty ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:int ;
    rdfs:label "violating endpoint count" .

### Power analysis properties
eda:internalPower a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:PowerAnalysis eda:Instance) ] ;
    rdfs:range xsd:float ;
    rdfs:label "internal power" ;
    qudt:unit unit:MilliW .

eda:leakagePower a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:PowerAnalysis eda:Instance) ] ;
    rdfs:range xsd:float ;
    rdfs:label "leakage power" ;
    qudt:unit unit:MilliW .

eda:switchingPower a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (eda:PowerAnalysis eda:Instance) ] ;
    rdfs:range xsd:float ;
    rdfs:label "switching power" ;
    qudt:unit unit:MilliW .

eda:macroPower a owl:DatatypeProperty ;
    rdfs:domain eda:PowerAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "macro power" ;
    qudt:unit unit:MilliW .

eda:totalPower a owl:DatatypeProperty ;
    rdfs:domain eda:PowerAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "total power" ;
    qudt:unit unit:MilliW .

