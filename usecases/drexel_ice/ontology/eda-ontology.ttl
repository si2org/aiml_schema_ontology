eda:no_of_outputs a owl:DatatypeProperty ;
    rdfs:domain eda:Netlist ;
    rdfs:range xsd:int ;
    rdfs:label "no of outputs" .

eda:no_of_cells a owl:DatatypeProperty ;
    rdfs:domain eda:Netlist ;
