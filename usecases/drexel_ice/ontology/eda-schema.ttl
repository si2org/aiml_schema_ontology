### Entity: Stage
eda:Stage a owl:Class ;
    rdfs:label "Stage" ;
    rdfs:comment "A distinct phase or step within an EDA flow execution." .

eda:name a owl:DatatypeProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range xsd:string ;
    rdfs:label "stage name" .

eda:has_netlist a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:Netlist ;
    rdfs:label "netlist" .

eda:cell_metrics a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:CellMetrics ;
    rdfs:label "cell metrics" .

eda:area_metrics a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:AreaMetrics ;
    rdfs:label "area metrics" .

eda:power_metrics a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:PowerMetrics ;
    rdfs:label "power metrics" .

eda:timing_metrics a owl:ObjectProperty ;
    rdfs:domain eda:Stage ;
    rdfs:range eda:TimingMetrics ;
    rdfs:label "critical path metrics" .


### Entity: Flow
eda:Flow a owl:Class ;
    rdfs:label "Flow" ;
    rdfs:comment "Represents an EDA process flow execution instance with stages." .

eda:has_stage a owl:ObjectProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range eda:Stage ;
    rdfs:label "has Stage" .

eda:timestamp a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:dateTime ;
    rdfs:label "timestamp" .

eda:runtime a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:float ;
    rdfs:label "runtime" .

eda:tool_name a owl:DatatypeProperty ;
    rdfs:domain eda:Flow ;
    rdfs:range xsd:string ;
    rdfs:label "tool name" .