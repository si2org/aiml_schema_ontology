@prefix eda: <http://example.org/eda#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .



### Entity: StandardCell
eda:StandardCell a owl:Class ;
    rdfs:label "StandardCell" ;
    rdfs:comment "StandardCell description." .

eda:name a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

eda:width a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "width" .

eda:height a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "height" .

eda:no_of_input_pins a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:int ;
    rdfs:label "no of input pins" .

eda:no_of_output_pins a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:int ;
    rdfs:label "no of output pins" .

eda:is_sequential a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:boolean ;
    rdfs:label "is sequential" .

eda:is_inverter a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:boolean ;
    rdfs:label "is inverter" .

eda:is_buffer a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:boolean ;
    rdfs:label "is buffer" .

eda:drive_strength a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "drive strength" .

eda:input_capacitance_min a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "input capacitance min" .

eda:input_capacitance_max a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "input capacitance max" .

eda:output_capacitance_min a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "output capacitance min" .

eda:output_capacitance_max a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "output capacitance max" .

eda:leakage_power_min a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "leakage power min" .

eda:leakage_power_max a owl:DatatypeProperty ;
    rdfs:domain eda:StandardCell ;
    rdfs:range xsd:float ;
    rdfs:label "leakage power max" .


