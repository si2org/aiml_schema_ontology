    rdfs:domain eda:ClockLatency ;
    rdfs:range xsd:float ;
    rdfs:label "network latency" ;
    qudt:unit unit:NanoSecond .

# Property defining clock skew component in nanoseconds
eda:clockSkew a owl:DatatypeProperty ;
    rdfs:domain eda:ClockUncertainty ;
    rdfs:range xsd:float ;
    rdfs:label "clock skew component" ;
    qudt:unit unit:NanoSecond .

# Property defining clock jitter component in nanoseconds
eda:clockJitter a owl:DatatypeProperty ;
    rdfs:domain eda:ClockUncertainty ;
    rdfs:range xsd:float ;
    rdfs:label "clock jitter component" ;
    qudt:unit unit:NanoSecond .

# Property defining setup uncertainty in nanoseconds
eda:setupUncertainty a owl:DatatypeProperty ;
    rdfs:domain eda:ClockUncertainty ;
    rdfs:range xsd:float ;
    rdfs:label "setup uncertainty" ;
    qudt:unit unit:NanoSecond .

# Property defining hold uncertainty in nanoseconds
eda:holdUncertainty a owl:DatatypeProperty ;
    rdfs:domain eda:ClockUncertainty ;
    rdfs:range xsd:float ;
    rdfs:label "hold uncertainty" ;
    qudt:unit unit:NanoSecond .

# Path properties defining multi-cycle path characteristics
### Path properties

# Property defining cycle count for multi-cycle paths
eda:cycleCount a owl:DatatypeProperty ;
    rdfs:domain eda:MultiCyclePath ;
    rdfs:range xsd:integer ;
    rdfs:label "cycle count" .



### sources, propagation, gating
eda:ClockSource a owl:Class .

eda:PLL a owl:Class ;
	rdfs:subClassOf eda:ClockSource .

eda:Oscillator a owl:Class ;
	rdfs:subClassOf eda:ClockSource .

eda:ExternalClockSource a owl:Class ;
	rdfs:subClassOf eda:ClockSource .

eda:ClockPropagationMode a owl:Class .

eda:IdealClockMode a owl:Class ;
	rdfs:subClassOf eda:ClockPropagationMode .

eda:PropagatedClockMode a owl:Class ;
	rdfs:subClassOf eda:ClockPropagationMode .

eda:ClockGatingCell a owl:Class ;
	rdfs:subClassOf eda:Instance .

eda:hasClockSource a owl:ObjectProperty ;
	rdfs:domain eda:Clock ;
	rdfs:range eda:ClockSource .

eda:clockPropagationMode a owl:ObjectProperty ;
	rdfs:domain eda:Clock ;
	rdfs:range eda:ClockPropagationMode .


### Variations
eda:VariationMode a owl:Class ;
	rdfs:subClassOf eda:Mode .

eda:OCV  a owl:Class ;
	rdfs:subClassOf eda:VariationMode .

eda:AOCV a owl:Class ;
	rdfs:subClassOf eda:VariationMode .

eda:POCV a owl:Class ;
	rdfs:subClassOf eda:VariationMode .

eda:SOCV a owl:Class ;
	rdfs:subClassOf eda:VariationMode .

eda:usesVariationMode a owl:ObjectProperty ;
	rdfs:domain eda:TimingAnalysis ;
	rdfs:range eda:VariationMode .


eda:TimingScenario a owl:Class .

eda:hasOperatingCondition a owl:ObjectProperty ;
	rdfs:domain eda:TimingScenario ;
	rdfs:range eda:OperatingCondition .

eda:hasRCCorner a owl:ObjectProperty ;
	rdfs:domain eda:TimingScenario ;
	rdfs:range eda:RCCorner .

eda:scenarioConstraints a owl:ObjectProperty ;
	rdfs:domain eda:TimingScenario ;
	rdfs:range eda:SDC .

eda:analyzedInScenario a owl:ObjectProperty ;
	rdfs:domain eda:TimingAnalysis ;
	rdfs:range eda:TimingScenario .

# PVT (explicit units)
eda:processCorner a owl:DatatypeProperty ;
	rdfs:domain eda:OperatingCondition ;
	rdfs:range xsd:string .


### Derate facts
eda:Derate a owl:Class ;
  rdfs:comment "A single derate entry scoped to scenario, target kind, polarity, and edge." .

eda:derateValue a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:double .

eda:derateForScenario a owl:ObjectProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range eda:TimingScenario .

# 'cell' | 'net' | 'clock'
eda:derateTargetKind a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:string .

# 'early' | 'late'
eda:deratePolarity a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:string .

# 'rise' | 'fall' | 'both'
eda:derateEdge a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:string .

# for AOCV depth
eda:derateDepth a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:integer .

# um for AOCV distance
eda:derateDistance a owl:DatatypeProperty ;
	rdfs:domain eda:Derate ;
	rdfs:range xsd:double .


