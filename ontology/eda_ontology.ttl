# Cardinality constraints ensuring proper file format dependencies and usage
### Cardinality Constraints

# Constraint: LEF files are required for DEF processing
eda:DEFFile rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty eda:dependsOn ;
    owl:someValuesFrom eda:LEFFile ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Constraint: Timing signoff requires at least one SDC and one SPEF file
eda:TimingSignoff rdfs:subClassOf [
		a owl:Restriction ;
		owl:onProperty eda:consumes ;
		owl:someValuesFrom eda:SDCFile ;
		owl:minCardinality "1"^^xsd:nonNegativeInteger
	] , [
		a owl:Restriction ;
		owl:onProperty eda:consumes ;
		owl:someValuesFrom eda:SPEFFile ;
		owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Constraint: GDSII files are consumed by exactly one patterning process
eda:GDSIIFile rdfs:subClassOf [
		a owl:Restriction ;
		owl:onProperty eda:isInputTo ;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		owl:onClass eda:Patterning
] .

# Axiom ensuring consistency between consumes and isInputTo properties
### Axioms for Reasoning
[] a owl:Axiom ;
    owl:annotatedSource eda:consumes ;
    owl:annotatedTarget eda:isInputTo ;
    owl:annotatedProperty owl:inverseOf ;
    rdfs:comment "Ensures that consumes and isInputTo are consistently linked." .

# Comprehensive disjointness declarations for all file format types
# File formats are distinct from each other
eda:LEFFile owl:disjointWith eda:DEFFile, eda:SDCFile, eda:SPEFFile, eda:GDSIIFile, eda:LIBFile, eda:VerilogFile, eda:VHDLFile, eda:SPFFile, eda:OASISFile, eda:UPFFile, eda:CPFFile, eda:SDFFile, eda:VCDFile, eda:FSDBFile, eda:SAIFFile, eda:ECOFile, eda:DRCFile, eda:LVSFile, eda:PGDFile, eda:CDLFile, eda:SPICEFile .
