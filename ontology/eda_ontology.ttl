# System-level properties defining inter-chiplet and thermal characteristics
### System-level properties

# Property defining inter-chiplet delay in picoseconds
eda:interChipletDelay a owl:DatatypeProperty ;
    rdfs:label "inter-chiplet delay" ;
    rdfs:domain eda:SystemLevelNet ;
    rdfs:range xsd:float ;
    qudt:unit unit:PicoSecond ;
    rdfs:comment "Delay associated specifically with the portion of a net connecting different chiplets." .

# Property defining maximum temperature in degrees Celsius
eda:maxTemperature a owl:DatatypeProperty ;
    rdfs:label "maximum temperature" ;
    rdfs:domain eda:ThermalMetric ;
    rdfs:range xsd:float ;
    qudt:unit unit:DegreeCelsius ;
    rdfs:comment "Maximum temperature observed or allowed in a component or region." .

# Property defining junction temperature in degrees Celsius
eda:junctionTemperature a owl:DatatypeProperty ;
    rdfs:label "junction temperature" ;
    rdfs:domain eda:ThermalMetric ;
    rdfs:range xsd:float ;
    qudt:unit unit:DegreeCelsius ;
    rdfs:comment "Temperature at the semiconductor junction within a chiplet." .

# Property defining thermal resistance in Kelvin per Watt
eda:thermalResistance a owl:DatatypeProperty ;
    rdfs:label "thermal resistance" ;
    rdfs:domain [ owl:unionOf (eda:InterconnectElement eda:Material eda:Chiplet eda:Interposer eda:PackageSubstrate) ] ;
    rdfs:range xsd:float ;
    qudt:unit unit:KelvinPerWatt ;
    rdfs:comment "Thermal resistance property of a component or material influencing heat dissipation." .

# Property defining system-level IR drop in millivolts
eda:systemIRDrop a owl:DatatypeProperty ;
    rdfs:label "system IR drop" ;
    rdfs:domain eda:PowerDeliveryNetworkMetric ;
    rdfs:range xsd:float ;
    qudt:unit unit:MilliVolt ;
    rdfs:comment "Voltage drop across the power delivery network spanning multiple components." .

# Disjointness axioms ensuring logical separation between ontology classes
###### Disjointness Axioms ######

# Process disjointness ensuring logical and physical design phases are distinct
### Process Disjointness
eda:LogicalDesign owl:disjointWith eda:PhysicalDesign .
eda:Verification owl:disjointWith eda:LogicalSynthesis, eda:PhysicalDesign .
eda:LogicalSynthesis owl:disjointWith eda:PhysicalDesign .

# Subprocess disjointness ensuring physical design steps are distinct
### Subprocess Disjointness
eda:Floorplanning owl:disjointWith eda:Placement, eda:Routing, eda:ClockTreeSynthesis, eda:ParasiticExtraction, eda:OPC .
eda:Placement owl:disjointWith eda:Routing, eda:ClockTreeSynthesis, eda:ParasiticExtraction, eda:OPC .
eda:Routing owl:disjointWith eda:ClockTreeSynthesis, eda:ParasiticExtraction, eda:OPC .
eda:ClockTreeSynthesis owl:disjointWith eda:ParasiticExtraction, eda:OPC .
eda:ParasiticExtraction owl:disjointWith eda:OPC .

# Verification subprocess disjointness ensuring verification methods are distinct
### Verification Subprocess Disjointness
eda:Simulation owl:disjointWith eda:FormalVerification, eda:DesignRuleChecking, eda:TimingSignoff, eda:LayoutVsSchematic .
eda:FormalVerification owl:disjointWith eda:DesignRuleChecking, eda:TimingSignoff, eda:LayoutVsSchematic .
eda:DesignRuleChecking owl:disjointWith eda:TimingSignoff, eda:LayoutVsSchematic .
eda:TimingSignoff owl:disjointWith eda:LayoutVsSchematic .

# Design artifact disjointness ensuring artifact types are mutually exclusive
### Design Artifact Disjointness
eda:RTL owl:disjointWith eda:Netlist, eda:Layout, eda:GDSII, eda:Mask, eda:SDC, eda:VerificationReport, eda:CircuitGraph .
eda:Netlist owl:disjointWith eda:Layout, eda:GDSII, eda:Mask, eda:SDC, eda:VerificationReport, eda:CircuitGraph .
eda:Layout owl:disjointWith eda:Mask, eda:SDC, eda:VerificationReport, eda:CircuitGraph .
eda:GDSII owl:disjointWith eda:Mask, eda:SDC, eda:VerificationReport, eda:CircuitGraph .
eda:Mask owl:disjointWith eda:SDC, eda:VerificationReport, eda:CircuitGraph .
eda:SDC owl:disjointWith eda:VerificationReport, eda:CircuitGraph .
eda:VerificationReport owl:disjointWith eda:CircuitGraph .

# Design element disjointness ensuring circuit components are distinct
### Design Element Disjointness
eda:Instance owl:disjointWith eda:Net, eda:Pin, eda:Port, eda:Wire, eda:Via .
eda:Net owl:disjointWith eda:Pin, eda:Port, eda:Wire, eda:Via .
eda:Pin owl:disjointWith eda:Port, eda:Wire, eda:Via .
eda:Port owl:disjointWith eda:Wire, eda:Via .
eda:Wire owl:disjointWith eda:Via .

# Pin type disjointness ensuring signal and power pins are distinct
### Pin Type Disjointness
eda:SignalPin owl:disjointWith eda:PowerPin .

# Analysis disjointness ensuring different analysis types are distinct
### Analysis Disjointness
eda:TimingMetric owl:disjointWith eda:PowerMetric, eda:AreaMetric .
eda:PowerMetric owl:disjointWith eda:AreaMetric .

# Corner type disjointness ensuring different corner types are distinct
### Corner Type Disjointness
eda:ProcessCorner owl:disjointWith eda:VoltageCorner, eda:TemperatureCorner .
eda:VoltageCorner owl:disjointWith eda:TemperatureCorner .
eda:RCCorner owl:disjointWith eda:LibCorner .

# Timing component disjointness ensuring timing concepts are logically separate
### Timing Component Disjointness
eda:TimingGraph owl:disjointWith eda:TimingPath, eda:Clock .
eda:TimingNode owl:disjointWith eda:TimingEdge .
eda:StartPoint owl:disjointWith eda:EndPoint, eda:IntermediatePoint .
eda:EndPoint owl:disjointWith eda:IntermediatePoint .

# Inverse properties defining bidirectional relationships
###### Inverse Properties ######

# Inverse property for consumes relationship
eda:isConsumedBy a owl:ObjectProperty ;
    owl:inverseOf eda:consumes .

# Inverse property for produces relationship
eda:isProducedBy a owl:ObjectProperty ;
    owl:inverseOf eda:produces .

# Inverse property for usesTool relationship
eda:isUsedBy a owl:ObjectProperty ;
    owl:inverseOf eda:usesTool .

# Inverse property for hasNet relationship
eda:belongsToDesign a owl:ObjectProperty ;
    owl:inverseOf eda:hasNet .

# Inverse property for hasStage relationship
eda:isStageOf a owl:ObjectProperty ;
    owl:inverseOf eda:hasStage .

# Aliases and abbreviations for commonly used timing metrics
######## aliases, abbreviations #########

# Alias for worstSlack - commonly referred to as WS
eda:ws a owl:DatatypeProperty ;
    owl:equivalentProperty eda:worstSlack ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "WS (Worst Slack)" ;
    rdfs:comment "Alias for worstSlack - represents the worst slack value in timing analysis." ;
    qudt:unit unit:NanoSecond .

# Alias for worstNegativeSlack - commonly referred to as WNS
eda:wns a owl:DatatypeProperty ;
    owl:equivalentProperty eda:worstNegativeSlack ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "WNS (Worst Negative Slack)" ;
    rdfs:comment "Alias for worstNegativeSlack - represents the worst negative slack value in timing analysis." ;
    qudt:unit unit:NanoSecond .

# Alias for totalNegativeSlack - commonly referred to as TNS
eda:tns a owl:DatatypeProperty ;
    owl:equivalentProperty eda:totalNegativeSlack ;
    rdfs:domain eda:TimingAnalysis ;
    rdfs:range xsd:float ;
    rdfs:label "TNS (Total Negative Slack)" ;
    rdfs:comment "Alias for totalNegativeSlack - represents the total negative slack value in timing analysis." ;
    qudt:unit unit:NanoSecond .

# Machine learning card definitions for model and dataset representation
######### ML Card definitions ##########

# MLCard class representing machine learning model metadata
ml:MLCard a owl:Class ;
    rdfs:label "MLCard" ;
    rdfs:comment "A class representing a machine learning model card" .

# Property defining model name for ML cards
ml:model a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "model" ;
    rdfs:comment "The model name" ;
    rdfs:range xsd:string .

# Property defining model version for ML cards
ml:version a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "version" ;
    rdfs:comment "The version of the model" ;
    rdfs:range xsd:string .

# Property defining model architecture for ML cards
ml:architecture a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "architecture" ;
    rdfs:comment "The architecture of the model" ;
    rdfs:range xsd:string .

# Property defining loss function used in model training
ml:lossFunction a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "lossFunction" ;
    rdfs:comment "The loss function used in the model" ;
    rdfs:range xsd:string .

# Property defining optimizer used in model training
ml:optimizer a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "optimizer" ;
    rdfs:comment "The optimizer used in the model" ;
    rdfs:range xsd:string .

# Property defining batch size used during training
ml:batchSize a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "batchSize" ;
    rdfs:comment "The batch size used during training" ;
    rdfs:range xsd:int .

# Property defining learning rate used during training
ml:learningRate a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "learningRate" ;
    rdfs:comment "The learning rate used during training" ;
    rdfs:range xsd:float .

# Property defining number of training epochs
ml:epochs a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "epochs" ;
    rdfs:comment "The number of epochs used for training" ;
    rdfs:range xsd:int .

# Property defining dropout rate used during training
ml:dropoutRate a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "dropoutRate" ;
    rdfs:comment "The dropout rate used during training" ;
    rdfs:range xsd:float .

# Property defining model inference latency
ml:inferenceLatency a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "inferenceLatency" ;
    rdfs:comment "The latency of the model during inference" ;
    rdfs:range xsd:float .

# Property defining model memory footprint
ml:memoryFootprint a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "memoryFootprint" ;
    rdfs:comment "The memory footprint of the model" ;
    rdfs:range xsd:float .

# Property defining training accuracy achieved by model
ml:trainingAccuracy a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "trainingAccuracy" ;
    rdfs:comment "The training accuracy of the model" ;
    rdfs:range xsd:float .

# Property defining test accuracy achieved by model
ml:testAccuracy a owl:DatatypeProperty ;
    rdfs:domain ml:MLCard ;
    rdfs:label "testAccuracy" ;
    rdfs:comment "The test accuracy of the model" ;
    rdfs:range xsd:float .

# Dataset class as subclass of MLCard for training and testing data
ml:Dataset a owl:Class ;
    rdfs:subClassOf ml:MLCard ;
    rdfs:label "Dataset" ;
    rdfs:comment "A class representing a dataset used for training and testing" .

# Property defining dataset type classification
ml:datasetType a owl:DatatypeProperty ;
    rdfs:domain ml:Dataset ;
    rdfs:label "datasetType" ;
    rdfs:comment "The type of the dataset" ;
    rdfs:range xsd:string .

# Property defining dataset version identifier
ml:datasetVersion a owl:DatatypeProperty ;
    rdfs:domain ml:Dataset ;
    rdfs:label "datasetVersion" ;
    rdfs:comment "The version of the dataset" ;
    rdfs:range xsd:string .

# Property defining dataset description
ml:description a owl:DatatypeProperty ;
    rdfs:domain ml:Dataset ;
    rdfs:label "description" ;
    rdfs:comment "The description of the dataset" ;
    rdfs:range xsd:string .

# Property defining dataset source information
ml:source a owl:DatatypeProperty ;
    rdfs:domain ml:Dataset ;
    rdfs:label "source" ;
    rdfs:comment "The source of the dataset" ;
    rdfs:range xsd:string .

# Property defining dataset size
ml:size a owl:DatatypeProperty ;
    rdfs:domain ml:Dataset ;
    rdfs:label "size" ;
    rdfs:comment "The size of the dataset" ;
    rdfs:range xsd:float .

# Extraction tool for parasitic R and C extraction
### Extraction tools
eda:ParasiticExtractionTool a owl:Class ;
    rdfs:subClassOf eda:Tool ;
    rdfs:label "Parasitic Extraction Tool" ;
    rdfs:comment "A tool that extracts parasitic resistance and capacitance from layout." ;
    eda:produces eda:Netlist .

# File format superclass and subclasses for EDA data representation
### File Format Superclass
eda:FileFormat a owl:Class ;
    rdfs:subClassOf eda:DesignArtifact ;
    rdfs:label "File Format" ;
    rdfs:comment "A specific file format used in EDA processes to represent design or technology data." ;
    owl:disjointWith eda:RTL, eda:Netlist, eda:Layout, eda:Mask, eda:TimingGraph, eda:CircuitGraph .

# LEF file format for library and technology exchange
eda:LEFFile a owl:Class ;
    rdfs:subClassOf eda:TechLEF ;
    rdfs:label "LEF File" ;
    rdfs:comment "Library Exchange Format file defining abstract physical layout for cells and technology." ;
    eda:isInputTo eda:Placement, eda:Routing ;
    eda:isOutputOf eda:TechnologyMapping ;
    eda:isSupportedBy eda:CadenceInnovus, eda:SynopsysICCompiler, eda:MentorCalibre ;
    owl:disjointWith eda:DEFFile, eda:SDCFile, eda:SPEFFile, eda:GDSIIFile, eda:LIBFile, eda:VerilogFile .

# DEF file format for design exchange with placement and routing
eda:DEFFile a owl:Class ;
    rdfs:subClassOf eda:Layout ;
    rdfs:label "DEF File" ;
    rdfs:comment "Design Exchange Format file describing physical layout, including placement and routing." ;
    eda:isInputTo eda:Routing, eda:ParasiticExtraction, eda:DesignRuleChecking ;
    eda:isOutputOf eda:Placement, eda:Routing ;
    eda:isSupportedBy eda:CadenceInnovus, eda:SynopsysICCompiler, eda:OpenROAD ;
    eda:dependsOn eda:LEFFile ;
    owl:disjointWith eda:SDCFile, eda:SPEFFile, eda:GDSIIFile, eda:LIBFile, eda:VerilogFile .

# SDC file format for timing constraints specification
eda:SDCFile a owl:Class ;
    rdfs:subClassOf eda:SDC ;
    rdfs:label "SDC File" ;
    rdfs:comment "Synopsys Design Constraints file specifying timing constraints for synthesis and timing analysis." ;
    eda:isInputTo eda:LogicalSynthesis, eda:TimingSignoff, eda:ClockTreeSynthesis ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:SynopsysDesignCompiler, eda:CadenceGenus, eda:SynopsysPrimeTime ;
    owl:disjointWith eda:SPEFFile, eda:GDSIIFile, eda:LIBFile, eda:VerilogFile .

# SPEF file format for parasitic data exchange
eda:SPEFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "SPEF File" ;
    rdfs:comment "Standard Parasitic Exchange Format file capturing interconnect parasitic data." ;
    eda:isInputTo eda:TimingSignoff, eda:PowerAnalysis ;
    eda:isOutputOf eda:ParasiticExtraction ;
    eda:isSupportedBy eda:SynopsysPrimeTime, eda:CadenceTempus, eda:MentorCalibre ;
    owl:disjointWith eda:GDSIIFile, eda:LIBFile, eda:VerilogFile .

# GDSII file format for final layout and mask generation
eda:GDSIIFile a owl:Class ;
    rdfs:subClassOf eda:GDSII ;
    rdfs:label "GDSII File" ;
    rdfs:comment "Graphic Data System II file for final layout data used in mask generation." ;
    eda:isInputTo eda:Patterning, eda:DesignRuleChecking, eda:OPC ;
    eda:isOutputOf eda:PhysicalDesign ;
    eda:isSupportedBy eda:CadenceVirtuoso, eda:MentorCalibre, eda:KLayout ;
    eda:usedInManufacturingStep eda:Patterning ;
    owl:disjointWith eda:LIBFile, eda:VerilogFile .

# LIB file format for liberty timing and power characterization
eda:LIBFile a owl:Class ;
    rdfs:subClassOf eda:TechnologyLibrary ;
    rdfs:label "LIB File" ;
    rdfs:comment "Liberty Format file characterizing timing, power, and noise for cells." ;
    eda:isInputTo eda:LogicalSynthesis, eda:TimingSignoff ;
    eda:isOutputOf eda:TechnologyMapping ;
    eda:isSupportedBy eda:SynopsysDesignCompiler, eda:CadenceGenus, eda:SynopsysPrimeTime ;
    owl:disjointWith eda:VerilogFile .

# Verilog file format for HDL design specification
eda:VerilogFile a owl:Class ;
    rdfs:subClassOf eda:RTL ;
    rdfs:label "Verilog File" ;
    rdfs:comment "Verilog HDL file for design specification and simulation." ;
    eda:isInputTo eda:LogicalSynthesis, eda:Simulation, eda:FormalVerification ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:SynopsysVCS, eda:CadenceIncisive, eda:MentorQuesta .

# VHDL file format for alternative HDL design specification
eda:VHDLFile a owl:Class ;
    rdfs:subClassOf eda:RTL ;
    rdfs:label "VHDL File" ;
    rdfs:comment "VHDL file for design specification and simulation." ;
    eda:isInputTo eda:LogicalSynthesis, eda:Simulation, eda:FormalVerification ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:MentorQuesta, eda:CadenceIncisive, eda:SynopsysVCS .

# SPF file format for legacy parasitic data (replaced by SPEF)
eda:SPFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "SPF File" ;
    rdfs:comment "Standard Parasitic Format file for parasitic data, largely replaced by SPEF." ;
    eda:isInputTo eda:TimingSignoff ;
    eda:isOutputOf eda:ParasiticExtraction ;
    eda:isSupportedBy eda:SynopsysPrimeTime, eda:CadenceTempus ;
    owl:disjointWith eda:OASISFile, eda:UPFFile, eda:CPFFile .

# OASIS file format for compact layout representation
eda:OASISFile a owl:Class ;
    rdfs:subClassOf eda:GDSII ;
    rdfs:label "OASIS File" ;
    rdfs:comment "Open Artwork System Interchange Standard file, a compact layout format for mask preparation." ;
    eda:isInputTo eda:Patterning, eda:DesignRuleChecking ;
    eda:isOutputOf eda:PhysicalDesign ;
    eda:isSupportedBy eda:MentorCalibre, eda:SynopsysICValidator, eda:KLayout ;
    eda:usedInManufacturingStep eda:Patterning .

# UPF file format for unified power format specification
eda:UPFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "UPF File" ;
    rdfs:comment "Unified Power Format file specifying power intent for low-power design." ;
    eda:isInputTo eda:LogicalSynthesis, eda:PowerAnalysis ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:SynopsysDesignCompiler, eda:CadenceGenus, eda:SynopsysPrimePower .

# CPF file format for common power format (alternative to UPF)
eda:CPFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "CPF File" ;
    rdfs:comment "Common Power Format file for low-power design, alternative to UPF." ;
    eda:isInputTo eda:LogicalSynthesis, eda:PowerAnalysis ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:CadenceGenus, eda:SynopsysDesignCompiler, eda:CadenceConformal .

# SDF file format for standard delay format back-annotation
eda:SDFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "SDF File" ;
    rdfs:comment "Standard Delay Format file for back-annotated delay information." ;
    eda:isInputTo eda:Simulation, eda:TimingSignoff ;
    eda:isOutputOf eda:TimingSignoff ;
    eda:isSupportedBy eda:SynopsysVCS, eda:CadenceIncisive, eda:SynopsysPrimeTime .

# VCD file format for simulation waveform recording
eda:VCDFile a owl:Class ;
    rdfs:subClassOf eda:VerificationReport ;
    rdfs:label "VCD File" ;
    rdfs:comment "Value Change Dump file recording signal changes during simulation." ;
    eda:isInputTo eda:PowerAnalysis ;
    eda:isOutputOf eda:Simulation ;
    eda:isSupportedBy eda:SynopsysVCS, eda:CadenceIncisive, eda:MentorQuesta .

# FSDB file format for fast signal database (Synopsys proprietary)
eda:FSDBFile a owl:Class ;
    rdfs:subClassOf eda:VerificationReport ;
    rdfs:label "FSDB File" ;
    rdfs:comment "Fast Signal Database file for simulation waveforms (Synopsys proprietary)." ;
    eda:isInputTo eda:PowerAnalysis ;
    eda:isOutputOf eda:Simulation ;
    eda:isSupportedBy eda:SynopsysVerdi, eda:CadenceSimVision .

# SAIF file format for switching activity interchange
eda:SAIFFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "SAIF File" ;
    rdfs:comment "Switching Activity Interchange Format file for power estimation." ;
    eda:isInputTo eda:PowerAnalysis ;
    eda:isOutputOf eda:Simulation ;
    eda:isSupportedBy eda:SynopsysPrimePower, eda:CadenceJoules .

# ECO file format for engineering change orders
eda:ECOFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "ECO File" ;
    rdfs:comment "Engineering Change Order file for incremental design changes." ;
    eda:isInputTo eda:LogicalSynthesis, eda:PhysicalDesign ;
    eda:isOutputOf eda:FormalVerification ;
    eda:isSupportedBy eda:SynopsysFormality, eda:CadenceConformal, eda:CadenceInnovus .

# DRC file format for design rule check reports
eda:DRCFile a owl:Class ;
    rdfs:subClassOf eda:VerificationReport ;
    rdfs:label "DRC File" ;
    rdfs:comment "Design Rule Check file for physical verification of layout rules." ;
    eda:isOutputOf eda:DesignRuleChecking ;
    eda:isSupportedBy eda:MentorCalibre, eda:SynopsysICValidator, eda:CadencePVS ;
    eda:usedInManufacturingStep eda:MetrologyAndInspection .

# LVS file format for layout vs schematic verification reports
eda:LVSFile a owl:Class ;
    rdfs:subClassOf eda:VerificationReport ;
    rdfs:label "LVS File" ;
    rdfs:comment "Layout vs. Schematic file verifying layout matches netlist." ;
    eda:isOutputOf eda:LayoutVsSchematic ;
    eda:isSupportedBy eda:MentorCalibre, eda:SynopsysICValidator, eda:CadencePVS ;
    eda:usedInManufacturingStep eda:MetrologyAndInspection .

# PGD file format for power grid data
eda:PGDFile a owl:Class ;
    rdfs:subClassOf eda:FileFormat ;
    rdfs:label "PGD File" ;
    rdfs:comment "Power Grid Data file describing power grid connectivity." ;
    eda:isInputTo eda:PowerAnalysis ;
    eda:isOutputOf eda:PhysicalDesign ;
    eda:isSupportedBy eda:CadenceVoltus, eda:SynopsysPrimeRail .

# CDL file format for circuit description language
eda:CDLFile a owl:Class ;
    rdfs:subClassOf eda:Netlist ;
    rdfs:label "CDL File" ;
    rdfs:comment "Circuit Description Language file for LVS, often for analog designs." ;
    eda:isInputTo eda:LayoutVsSchematic ;
    eda:isOutputOf eda:LogicalSynthesis ;
    eda:isSupportedBy eda:MentorCalibre, eda:CadencePVS .

# SPICE file format for analog circuit simulation
eda:SPICEFile a owl:Class ;
    rdfs:subClassOf eda:Netlist ;
    rdfs:label "SPICE File" ;
    rdfs:comment "SPICE file describing analog circuits for simulation." ;
    eda:isInputTo eda:Simulation ;
    eda:isOutputOf eda:LogicalDesign ;
    eda:isSupportedBy eda:SynopsysHSPICE, eda:CadenceSpectre, eda:MentorEldo .

# Object properties defining file format relationships and dependencies
### Object Properties

# Property relating file formats to processes they serve as input
eda:isInputTo a owl:ObjectProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "is input to" ;
    rdfs:comment "Relates a file format to the EDA process it serves as input for." ;
    owl:inverseOf eda:consumes .

# Property relating file formats to processes that produce them
eda:isOutputOf a owl:ObjectProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range eda:EDAProcess ;
    rdfs:label "is output of" ;
    rdfs:comment "Relates a file format to the EDA process that produces it." ;
    owl:inverseOf eda:produces .

# Property relating file formats to tools that can process them
eda:isSupportedBy a owl:ObjectProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range eda:Tool ;
    rdfs:label "is supported by" ;
    rdfs:comment "Relates a file format to the tools that can process it." ;
    owl:inverseOf eda:usesTool .

# Property relating file formats to other formats they require
eda:dependsOn a owl:ObjectProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range eda:FileFormat ;
    rdfs:label "depends on" ;
    rdfs:comment "Relates a file format to another file format it requires." .

# Property relating file formats to manufacturing steps they support
eda:usedInManufacturingStep a owl:ObjectProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range eda:SemiconductorManufacturingProcess ;
    rdfs:label "used in manufacturing step" ;
    rdfs:comment "Relates a file format to the semiconductor manufacturing process it supports." .

# Datatype properties defining file format characteristics
### Datatype Properties

# Property defining file extension for formats
eda:fileExtension a owl:DatatypeProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range xsd:string ;
    rdfs:label "file extension" ;
    rdfs:comment "The file extension associated with the file format (e.g., '.lef', '.def')." .

# Property defining format version specification
eda:formatVersion a owl:DatatypeProperty ;
    rdfs:domain eda:FileFormat ;
    rdfs:range xsd:string ;
    rdfs:label "format version" ;
    rdfs:comment "The version of the file format specification." .

