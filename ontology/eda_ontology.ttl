# Resource properties defining computational requirements
### Resource properties

# Property defining memory requirements in gigabytes
eda:requiresMemory a owl:DatatypeProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range xsd:float ;
    rdfs:label "requires memory" ;
    qudt:unit unit:GigaBYTE .

# Property defining estimated runtime in minutes
eda:estimatedRuntime a owl:DatatypeProperty ;
    rdfs:domain eda:EDAProcess ;
    rdfs:range xsd:float ;
    rdfs:label "estimated runtime" ;
